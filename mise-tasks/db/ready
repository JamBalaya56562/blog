#!/usr/bin/env bash
#MISE description="Succeed once this run's DynamoDB Local answers and its table exists"
set -euo pipefail

# shellcheck source=common.sh
source mise-tasks/db/common.sh

# The daemon's readiness check. On a restart the previous container can still
# answer on the port for a moment after its db:start has been killed, until the
# new db:start removes it. A check that only asked the port would find the old
# table there, report ready, and leave the new container without one. So the
# container must be running and its owner, the db:start that labelled it, must
# be alive before the table is checked.
format="{{.State.Running}} {{index .Config.Labels \"${OWNER_LABEL}\"}}"
state="$(docker inspect --format "$format" "$CONTAINER_NAME" 2>/dev/null)" || state=""
read -r running owner <<<"$state"

if [ "${running:-}" != "true" ] || [ -z "${owner:-}" ] || ! kill -0 "$owner" 2>/dev/null; then
  echo "DynamoDB Local of a running db:start is not up yet." >&2
  exit 1
fi

exec mise run db:push
