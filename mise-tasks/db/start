#!/usr/bin/env bash
#MISE description="Run DynamoDB Local in the foreground"
set -euo pipefail

# The container runs in the foreground: its log is this task's output, and
# whatever stops this task stops the database. Backgrounding is the supervisor's
# job — `mise daemons start db` runs this same task as a daemon — so there is no
# second, detached code path to keep in step with this one.

# shellcheck source=common.sh
source mise-tasks/db/common.sh

# A container left behind by an earlier run — a SIGKILL, a Docker engine that
# died before --rm could fire — still owns the name and would fail the run
# below. `inspect` fails when no container has the name.
if docker inspect "$CONTAINER_NAME" >/dev/null 2>&1; then
  echo "Removing the container an earlier run left behind..."
  docker rm -f "$CONTAINER_NAME" >/dev/null
fi

stopped=0
stop() {
  trap - INT TERM
  stopped=1
  # The signal reaches the whole process group, so the client is usually already
  # gone and the container with it. This is the belt to that pair of braces: it
  # covers a signal sent to this script alone.
  docker stop "$CONTAINER_NAME" >/dev/null 2>&1 || true
}
trap stop INT TERM

# -sharedDb is required: without it DynamoDB Local namespaces tables per access
# key and region, so a mismatch between .env and any other client makes the
# table look missing.
#
# -inMemory keeps the data in RAM. Counts reset when the container stops, which
# is fine for a view counter in development and avoids the volume ownership
# problems the image has with a mounted -dbPath.
#
# Run it as a background job and `wait` on it, so INT and TERM reach the handler
# at once rather than after the container has exited of its own accord.
docker run --rm \
  --name "$CONTAINER_NAME" \
  -p "${DYNAMODB_PORT}:8000" \
  amazon/dynamodb-local \
  -jar DynamoDBLocal.jar -sharedDb -inMemory &

status=0
wait $! || status=$?

if [ "$stopped" -eq 1 ]; then
  echo "DynamoDB Local stopped."
  exit 0
fi

exit "$status"
